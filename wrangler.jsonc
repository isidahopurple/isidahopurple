{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isidahopurple",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": false,
  "routes": [{ "pattern": "isidahopurple.com", "custom_domain": true }],
  "env": {
    // Review build: npm run deploy:preview → isidahopurple-preview.<account>.workers.dev (noindex, shows /review)
    "preview": {
      "name": "isidahopurple-preview",
      "workers_dev": true,
      "routes": []
    }
  }
}
