{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFD0qD_71qPbQGfS astro build && rm -rf dist/review",
    "build:preview": "PUBLIC_PREVIEW=1 PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFD0qD_71qPbQGfS astro build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  }
}
