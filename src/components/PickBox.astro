---
import Party from './Party.astro';
import { t, tx, href, type Lang } from '../i18n/ui';
import type { Race } from '../lib/data';
interface Props { race: Race; lang: Lang; compact?: boolean }
const { race, lang, compact } = Astro.props;
const { pick, candidates } = race.data;
const cand = candidates.find((c) => c.name === pick.candidate);
const labelKey = `pick.${pick.label}` as Parameters<typeof t>[1];
const ruleNo = pick.rule.match(/\d/)?.[0];
const ruleText = ruleNo ? (lang === 'es' ? `Regla ${ruleNo} del método` : `Method rule ${ruleNo}`) : (lang === 'es' ? 'El método no aplica' : 'The method doesn’t apply');
---
<div class="pick card">
  <p class="pick-label"><span class="tag">{t(lang, labelKey)}</span> {!pick.approved && <span class="tag draft">{t(lang, 'race.pickPending')}</span>}</p>
  {cand && <p class="pick-name">{cand.name} <Party party={cand.party} lang={lang} /></p>}
  {!compact && <p>{tx(pick.reasoning, lang)}</p>}
  {!compact && <p class="small muted">{ruleText} · <a href={href(lang, '/experiment#method')}>{t(lang, 'pick.method')}</a></p>}
</div>
<style>
  .pick { border-left: 6px solid #7b3fc0; }
  .pick-label { margin: 0 0 4px; display: flex; gap: 6px; flex-wrap: wrap; }
  .pick-name { font-size: 1.35rem; font-weight: 800; margin: 4px 0; }
</style>
