---
// Address → legislative district, county, US House district. Uses /api/district (US Census geocoder).
import { href, tx, type Lang } from '../i18n/ui';
import { getRaces } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const all = await getRaces();
const ids = all.map((r) => r.id);
// County races, keyed by county name, so an address in Ada also lists Ada County offices.
const countyRaces = all.filter((r) => r.data.level === 'county').map((r) => ({ id: r.id, county: r.data.district ?? '', title: tx(r.data.office, lang) }));
const strings = es
  ? { again: 'Buscar otra dirección', useLoc: 'Usar mi ubicación', locating: 'Buscando su ubicación…', locDenied: 'No pudimos usar su ubicación. Escriba su dirección.', approx: 'Ubicación aproximada: si vive cerca del límite de un distrito, confírmelo con la búsqueda oficial.', matchedLabel: 'Encontramos', ld: 'Distrito legislativo', county: 'Condado', cd: 'Distrito del Congreso de EE. UU.', see: 'Ver sus contiendas', notFound: 'No encontramos esa dirección en Idaho. Pruebe con calle, ciudad y código postal, o use la búsqueda oficial.', error: 'La búsqueda no está disponible ahora. Use la búsqueda oficial.', looking: 'Buscando…', senate: 'Senado estatal', houseA: 'Cámara, puesto A', houseB: 'Cámara, puesto B', usHouse: 'Cámara de EE. UU.', notYet: 'Aún no tenemos página para este distrito.' }
  : { again: 'Look up another address', useLoc: 'Use my location', locating: 'Finding your location…', locDenied: 'We couldn’t use your location. Type your address instead.', approx: 'Approximate match: if you live near a district line, confirm with the official lookup.', matchedLabel: 'Found', ld: 'Legislative district', county: 'County', cd: 'US House district', see: 'See your races', notFound: 'We couldn’t find that address in Idaho. Try street, city and ZIP, or use the official lookup.', error: 'The lookup isn’t available right now. Use the official lookup.', looking: 'Looking up…', senate: 'State Senate', houseA: 'State House, seat A', houseB: 'State House, seat B', usHouse: 'US House', notYet: 'We don’t have pages for this district yet.' };
const base = href(lang, '/races/');
---
<form class="finder card" id="finder" data-county-races={JSON.stringify(countyRaces)} data-ids={JSON.stringify(ids)} data-base={base} data-strings={JSON.stringify(strings)}>
  <label for="addr"><strong>{es ? '¿En qué distrito vivo?' : 'Which district am I in?'}</strong></label>
  <div class="inputs">
  <div class="row">
    <input id="addr" name="address" autocomplete="street-address" placeholder={es ? 'Calle, ciudad, código postal' : 'Street, city, ZIP'} required minlength="5" />
    <button class="btn go" type="submit">{es ? 'Buscar' : 'Look up'}</button>
  </div>
  <button class="btn ghost loc" type="button">{es ? '⌖ Usar mi ubicación' : '⌖ Use my location'}</button>
  <p class="small muted">
    {es
      ? 'Su dirección (o ubicación) va a la Oficina del Censo de EE. UU., y si no la encuentra, a OpenStreetMap. No la guardamos. '
      : 'Your address (or location) goes to the US Census Bureau, and to OpenStreetMap if the Census can’t find it. We don’t store it. '}
    <a href="https://legislature.idaho.gov/legislators/whosmylegislator/" rel="noopener" target="_blank">{es ? 'Búsqueda oficial' : 'Official lookup'}</a>
  </p>
  </div>
  <div class="out" aria-live="polite"></div>
  <button class="btn ghost again" type="button" hidden></button>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.finder')) {
    const ids: string[] = JSON.parse(form.dataset.ids!);
    const countyRaces: { id: string; county: string; title: string }[] = JSON.parse(form.dataset.countyRaces!);
    const s = JSON.parse(form.dataset.strings!);
    const base = form.dataset.base!;
    const out = form.querySelector<HTMLDivElement>('.out')!;
    // Build the result with DOM methods (no innerHTML), so nothing from the lookup can inject markup.
    const el = (tag: string, text?: string) => { const e = document.createElement(tag); if (text) e.textContent = text; return e; };
    const link = (id: string, label: string) => {
      if (!ids.includes(id)) return null;
      const li = el('li'); const a = el('a', label) as HTMLAnchorElement; a.href = base + id; li.append(a); return li;
    };
    const inputs = form.querySelector<HTMLElement>('.inputs')!;
    const go = form.querySelector<HTMLButtonElement>('.go')!;
    const again = form.querySelector<HTMLButtonElement>('.again')!;
    again.textContent = s.again;
    const goLabel = go.textContent;
    const busy = (on: boolean) => {
      go.disabled = on; form.classList.toggle('busy', on);
      go.innerHTML = on ? `<span class="spin" aria-hidden="true"></span>${s.looking}` : '';
      if (!on) go.textContent = goLabel;
    };
    again.addEventListener('click', () => {
      inputs.hidden = false; again.hidden = true; out.replaceChildren();
      form.querySelector<HTMLInputElement>('input[name="address"]')?.focus();
    });
    const lookup = async (query: string) => {
      out.textContent = '';
      busy(true);
      try {
        const r = await fetch(`/api/district?${query}`);
        const d = await r.json();
        if (!r.ok) { out.textContent = d.error === 'lookup_unavailable' ? s.error : s.notFound; busy(false); return; }
        const n = Number.isInteger(d.ld) ? d.ld : null;
        const cd = Number.isInteger(d.cd) ? d.cd : null;
        const items = [link(`us-house-${cd}`, `${s.usHouse} ${cd}`), link(`ld${n}-senate`, s.senate), link(`ld${n}-house-a`, s.houseA), link(`ld${n}-house-b`, s.houseB),
          ...countyRaces.filter((c) => c.county === d.county).map((c) => link(c.id, c.title))].filter(Boolean) as HTMLElement[];
        out.replaceChildren();
        if (d.matched) { const m = el('p', `${s.matchedLabel}: ${d.matched}`); m.className = 'small muted'; out.append(m); }
        const head = el('p'); head.append(el('strong', `${s.ld}: ${n ?? '?'}`), ` · ${s.county}: ${d.county ?? '?'} · ${s.cd}: ${cd ?? '?'}`);
        out.append(head);
        if (d.approx) { const a = el('p', s.approx); a.className = 'small note'; out.append(a); }
        if (items.length) { const ul = el('ul'); ul.append(...items); out.append(el('p', `${s.see}:`), ul); }
        else { const p = el('p', s.notYet); p.className = 'small muted'; out.append(p); }
        // Collapse the form into the result, and open this district in the list below (Races page).
        inputs.hidden = true; again.hidden = false;
        const det = n ? document.getElementById(`ld${n}`) as HTMLDetailsElement | null : null;
        if (det) { document.querySelectorAll<HTMLDetailsElement>('details[id^="ld"]').forEach((x) => (x.open = x === det)); det.classList.add('mine'); }
        busy(false);
      } catch {
        out.textContent = s.error;
        busy(false);
      }
    };
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const address = (new FormData(form).get('address') as string).trim();
      lookup(`address=${encodeURIComponent(address)}`);
    });
    const loc = form.querySelector<HTMLButtonElement>('.loc')!;
    if (!('geolocation' in navigator)) loc.hidden = true;
    loc.addEventListener('click', () => {
      out.textContent = s.locating;
      busy(true);
      navigator.geolocation.getCurrentPosition(
        (pos) => lookup(`lat=${pos.coords.latitude.toFixed(4)}&lon=${pos.coords.longitude.toFixed(4)}`),
        () => { out.textContent = s.locDenied; busy(false); },
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 },
      );
    });
  }
</script>

<style>
  .finder { margin: 16px 0; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
  input { flex: 1 1 220px; min-height: 46px; padding: 8px 12px; font: inherit; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); }
  .out :global(p) { margin: 0.4rem 0; }
  .loc { width: 100%; margin-bottom: 6px; }
  .again { margin-top: 8px; }
  .go { min-width: 110px; }
  :global(.finder .spin) { width: 20px; height: 20px; border: 3px solid rgb(255 255 255 / 0.35); border-top-color: #fff; border-radius: 50%; display: inline-block; vertical-align: middle; margin-right: 8px; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .finder.busy .out { opacity: 0.8; }
</style>
