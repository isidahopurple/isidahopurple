---
// Home: the shortest path to voting. Four official links, one line each, then out of the way.
// Everything else (hypothesis, polls, picks, pledge) lives at /experiment.
import Base from '../layouts/Base.astro';
import { href, type Lang } from '../i18n/ui';
import { getElection } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const e = await getElection();
const url = (k: string) => {
  const v = e[k]?.value;
  const s = typeof v === 'string' ? v : v?.en ?? '';
  return s.match(/https?:\/\/\S+/)?.[0] ?? e[k]?.source.url ?? 'https://voteidaho.gov/';
};

const actions = es
  ? [
      { key: 'check', icon: '✓', title: '¿Estoy registrado?', sub: 'Revíselo en un minuto en el sitio oficial.', url: url('check_registration_url') },
      { key: 'register', icon: '✎', title: 'Registrarme para votar', sub: 'En línea con su licencia de Idaho o identificación estatal. Fecha límite: viernes 23 de octubre, 5 p.m.', url: url('register_online_url') },
      { key: 'absentee', icon: '✉', title: 'Votar por correo', sub: 'Pida su boleta de voto ausente. Cualquier votante puede. Su solicitud debe llegar antes del viernes 23 de octubre, 5 p.m.', url: url('absentee_request_url') },
      { key: 'where', icon: '⌖', title: '¿Dónde voto?', sub: 'Su lugar de votación el 3 de noviembre. En Ada, la votación anticipada es del 19 al 30 de octubre.', url: url('find_polling_place_url') },
    ]
  : [
      { key: 'check', icon: '✓', title: 'Am I registered?', sub: 'Check in about a minute on the official site.', url: url('check_registration_url') },
      { key: 'register', icon: '✎', title: 'Register to vote', sub: 'Online with your Idaho driver’s license or state ID. Deadline: Fri Oct 23, 5 p.m.', url: url('register_online_url') },
      { key: 'absentee', icon: '✉', title: 'Vote by mail', sub: 'Request your absentee ballot. Any voter can. Your request must arrive by Fri Oct 23, 5 p.m.', url: url('absentee_request_url') },
      { key: 'where', icon: '⌖', title: 'Where do I vote?', sub: 'Your polling place for Nov 3. In Ada County, early voting runs Oct 19–30.', url: url('find_polling_place_url') },
    ];
const shareText = es
  ? 'Cómo votar en Idaho: revise su registro, regístrese o pida su boleta por correo. Fecha límite: 23 de octubre.'
  : 'How to vote in Idaho: check your registration, register, or get a mail ballot. Deadline Oct 23.';
---
<Base lang={lang}
  title={es ? 'Cómo votar en Idaho' : 'How to vote in Idaho'}
  description={es ? 'Revise su registro, regístrese o pida su boleta por correo. Enlaces oficiales. Fecha límite: viernes 23 de octubre, 5 p.m.' : 'Check your registration, register, or get a mail ballot. Official links. Deadline: Fri Oct 23, 5 p.m.'}
  ogImage={`/og/home${es ? '-es' : ''}.jpg`}>
  <section class="intro">
    <h1>{es ? 'Vote en Idaho. Así se hace.' : 'Vote in Idaho. Here’s how.'}</h1>
    <p class="lede">{es ? 'Cuatro enlaces oficiales. Unos minutos cada uno.' : 'Four official links. A few minutes each.'}</p>
  </section>

  <ul class="actions">
    {actions.map((a) => (
      <li>
        <a class="action" href={a.url} target="_blank" rel="noopener" data-click={a.key}>
          <span class="icon" aria-hidden="true">{a.icon}</span>
          <span class="text"><span class="title">{a.title}</span><span class="sub">{a.sub}</span></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="official small muted">{es
    ? <>Se abre <strong>VoteIdaho</strong>, el sitio oficial del estado, en una pestaña nueva. La dirección debe terminar en <strong>voteidaho.gov</strong>.</>
    : <>Opens <strong>VoteIdaho</strong>, Idaho’s official site, in a new tab. The address should end in <strong>voteidaho.gov</strong>.</>}</p>

  <p class="more">
    <a href={href(lang, '/vote')}>{es ? 'Guía paso a paso, fechas y qué identificación llevar →' : 'Step-by-step guide, dates and what ID to bring →'}</a>
  </p>

  <section class="share card">
    <p class="share-title">{es ? '¿Conoce a alguien que nunca ha votado?' : 'Know someone who’s never voted?'}</p>
    <p class="small muted">{es ? 'Mándele esta página. Es lo más útil que puede hacer hoy.' : 'Send them this page. It’s the most useful thing you can do today.'}</p>
    <button class="btn" type="button" id="share" data-text={shareText} data-copied={es ? '¡Enlace copiado!' : 'Link copied!'}>{es ? 'Compartir' : 'Share'}</button>
    <p class="small"><a href={href(lang, '/share')}>{es ? 'Imágenes para Instagram →' : 'Images for Instagram →'}</a></p>
  </section>

  <section class="why">
    <p>
      <span class="purple-text why-q">{es ? '¿Es Idaho morado?' : 'Is Idaho purple?'}</span>
      {es ? ' Este sitio también es un experimento abierto. ' : ' This site is also an open experiment. '}
      <a href={href(lang, '/experiment')}>{es ? 'Vea la hipótesis →' : 'See the hypothesis →'}</a>
    </p>
    <p class="small"><a href={href(lang, '/races')}>{es ? 'Qué hay en su boleta →' : 'What’s on your ballot →'}</a></p>
  </section>

  <script>
    // Count outbound clicks by button only (no personal data). See /privacy.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-click]')) {
      a.addEventListener('click', () => { try { navigator.sendBeacon?.('/api/click', a.dataset.click!); } catch {} });
    }
    const btn = document.getElementById('share') as HTMLButtonElement | null;
    btn?.addEventListener('click', async () => {
      const data = { title: document.title, text: btn.dataset.text!, url: location.origin + location.pathname };
      try {
        if (navigator.share) { await navigator.share(data); return; }
        await navigator.clipboard.writeText(`${data.text} ${data.url}`);
        btn.textContent = btn.dataset.copied!;
      } catch {}
    });
  </script>
</Base>

<style>
  .intro { padding: 22px 0 6px; }
  .intro h1 { font-size: clamp(2rem, 8.5vw, 3.2rem); margin: 0.2rem 0 0.3rem; }
  .lede { font-size: 1.15rem; margin: 0; color: var(--muted); }
  .actions { list-style: none; padding: 0; margin: 18px 0 8px; display: grid; gap: 12px; }
  .actions li { max-width: none; }
  .action { display: grid; grid-template-columns: 48px 1fr 20px; gap: 14px; align-items: center; padding: 16px; min-height: 76px;
    background: var(--surface); border: 2px solid var(--line); border-radius: 14px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); }
  .action:hover, .action:focus-visible { border-color: var(--purple); }
  .icon { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; font-size: 1.5rem; font-weight: 800; color: #fff;
    background: linear-gradient(135deg, var(--red), #7b3fc0 55%, var(--blue)); }
  .text { display: grid; gap: 2px; }
  .title { font-size: 1.2rem; font-weight: 800; }
  .sub { font-size: 0.92rem; color: var(--muted); line-height: 1.35; }
  .arrow { color: var(--purple); font-weight: 800; font-size: 1.2rem; }
  .official { margin: 6px 2px 0; }
  .more { margin: 18px 0; font-weight: 600; }
  .share { margin: 22px 0; text-align: center; }
  .share-title { font-size: 1.15rem; font-weight: 800; margin: 0 0 4px; }
  .share .btn { margin-top: 8px; min-width: 160px; }
  .why { border-top: 1px solid var(--line); margin-top: 26px; padding-top: 14px; }
  .why-q { font-weight: 800; font-size: 1.1rem; }
</style>
