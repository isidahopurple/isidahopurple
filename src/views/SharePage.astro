---
// Ready-made images and captions for Instagram and texting. Built by assets-src/make_cards.py.
import Base from '../layouts/Base.astro';
import ShareButtons from '../components/ShareButtons.astro';
import NextStep from '../components/NextStep.astro';
import { href, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const sfx = es ? '-es' : '';
const site = es ? 'isidahopurple.com/es' : 'isidahopurple.com';
const sets = [
  {
    name: 'howto',
    title: es ? 'Cómo votar' : 'How to vote',
    caption: es
      ? `¿Nunca ha votado en Idaho o no sabe si sigue registrado? Son unos minutos: revise su registro, regístrese o pida su boleta por correo. Fecha límite: viernes 23 de octubre, 5 p.m. Enlaces oficiales en ${site} (enlace en mi perfil).`
      : `Never voted in Idaho, or not sure you’re still registered? It takes a few minutes: check your registration, register, or get a mail ballot. Deadline: Fri Oct 23, 5 p.m. Official links at ${site} (link in bio).`,
  },
  {
    name: 'purple',
    title: es ? '¿Es Idaho morado?' : 'Is Idaho purple?',
    caption: es
      ? `Todos dicen que Idaho es rojo. ¿Y si solo lo parece porque mucha gente no vota? Hay una forma de averiguarlo: el 3 de noviembre. Regístrese o pida su boleta por correo antes del 23 de octubre. ${site}`
      : `Everyone says Idaho is red. What if it only looks that way because so many people don’t vote? There’s one way to find out: Nov 3. Register or get a mail ballot by Oct 23. ${site}`,
  },
];
const text = es
  ? `¿Ya estás registrado para votar? Aquí están los enlaces oficiales de Idaho, toma unos minutos. Fecha límite: 23 de octubre. https://${site}`
  : `Are you registered to vote? Here are Idaho's official links, it takes a few minutes. Deadline is Oct 23. https://${site}`;
---
<Base lang={lang} title={es ? 'Compartir' : 'Share'} description={es ? 'Imágenes y textos listos para compartir.' : 'Images and captions ready to share.'}>
  <h1>{es ? 'Compártalo' : 'Share it'}</h1>
  <p class="lede">{es ? 'Mande el enlace a quien quiera, en un toque.' : 'Send the link to anyone, in one tap.'}</p>
  <ShareButtons lang={lang} />
  <p class="small muted">{es
    ? 'El enlace muestra una vista previa con imagen en mensajes, WhatsApp y Facebook.'
    : 'The link shows a preview with a picture in texts, WhatsApp and Facebook.'}</p>

  <h2>{es ? 'Para Instagram' : 'For Instagram'}</h2>
  <p>{es
    ? 'Instagram no permite compartir enlaces en publicaciones. Mantenga presionada una imagen (o tóquela y guárdela) y súbala. Copie el texto para el pie de foto. Ponga isidahopurple.com en su perfil o use un sticker de enlace en una historia.'
    : 'Instagram doesn’t allow links in posts. Press and hold an image (or tap it and save) to post it, and copy the caption below it. Put isidahopurple.com in your bio or use a link sticker in a story.'}</p>

  {sets.map((s) => (
    <section>
      <h3>{s.title}</h3>
      <div class="imgs">
        <a href={`/share/${s.name}-feed${sfx}.jpg`} download><img src={`/share/${s.name}-feed${sfx}.jpg`} alt={s.title} width="1080" height="1350" loading="lazy" /><span>{es ? 'Publicación (4:5)' : 'Feed post (4:5)'}</span></a>
        <a href={`/share/${s.name}-story${sfx}.jpg`} download><img src={`/share/${s.name}-story${sfx}.jpg`} alt={s.title} width="1080" height="1920" loading="lazy" /><span>{es ? 'Historia (9:16)' : 'Story (9:16)'}</span></a>
      </div>
      <div class="cap card"><p>{s.caption}</p><button class="btn ghost copy" type="button" data-copy={s.caption}>{es ? 'Copiar texto' : 'Copy caption'}</button></div>
    </section>
  ))}

  <section>
    <h2>{es ? 'Un mensaje listo para copiar' : 'A ready-made message to copy'}</h2>
    <div class="cap card"><p>{text}</p><button class="btn ghost copy" type="button" data-copy={text}>{es ? 'Copiar texto' : 'Copy text'}</button></div>
  </section>
  <p class="small muted">{es ? 'Sin anuncios pagados: esto se comparte de persona a persona.' : 'No paid ads: this spreads person to person.'}</p>
  <NextStep lang={lang} step="done" />

  <script>
    for (const b of document.querySelectorAll<HTMLButtonElement>('button.copy')) {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = '✓'; } catch {}
      });
    }
  </script>
</Base>
<style>
  .imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
  .imgs a { display: grid; gap: 4px; text-decoration: none; font-size: 0.85rem; color: var(--muted); }
  .imgs img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); }
  .cap { margin-top: 12px; }
  .cap p { margin-top: 0; }
</style>
